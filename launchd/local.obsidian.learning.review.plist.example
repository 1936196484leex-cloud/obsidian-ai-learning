<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUTF8</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>local.obsidian.learning.review</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PATH/TO/venv/bin/python</string>
		<string>-B</string>
		<string>/ABSOLUTE/PATH/TO/VAULT/automation/daily_review.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/PATH/TO/VAULT/automation/logs/review-launchd-error.log</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>22</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>/ABSOLUTE/PATH/TO/VAULT/automation</string>
</dict>
</plist>
